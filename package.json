{
  "name": "ops-hq-demo",
  "version": "1.1.0",
  "private": true,
  "description": "Interactive Ops HQ — webhook-relay + stripe ledger + llm-guardrails wired live",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/make-og.mjs",
    "build": "next build",
    "build:pages": "cross-env GITHUB_PAGES=true next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "vitest run && tsc --noEmit",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test:e2e:live": "cross-env PLAYWRIGHT_BASE_URL=https://marchikx.github.io/ops-hq-demo playwright test"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "geist": "^1.3.1",
    "llm-guardrails": "github:marchikx/llm-guardrails#main",
    "next": "^14.2.18",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stream-browserify": "^3.0.0",
    "stripe-payments-ledger": "github:marchikx/stripe-payments-ledger#main",
    "webhook-relay": "github:marchikx/webhook-relay#main"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
